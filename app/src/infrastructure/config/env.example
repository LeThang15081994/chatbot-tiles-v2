# ============================================
# Application Settings
# ============================================
APP_NAME=chatbot-tiles-v2
APP_VERSION=2.0.0
APP_ENVIRONMENT=development
APP_PORT=8000
API_V1_STR=/api/v1

# Product Base URL
PRODUCT_BASE_URL=https://gach.ai

# ============================================
# Shopping Cart API Settings
# ============================================
SHOPPING_CART_API_URL=https://gach.ai:7851/api/app/shopping-cart
SHOPPING_CART_API_TIMEOUT=30

# ============================================
# PostgreSQL Database Settings
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gachai_db
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_MAX_POOL_SIZE=20

# ============================================
# File Logging Settings
# ============================================
LOG_DIR=/app/logging
LOG_RETENTION_DAYS=15

# ============================================
# Milvus Vector Store Settings
# ============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB=chatbot_gachai
MILVUS_ALIAS=default
MILVUS_COLLECTION_COMPANY_DOCUMENT=company_document_info
MILVUS_COLLECTION_PRODUCTS=products
MILVUS_COLLECTION_PRODUCTS_INFO=products_info
MILVUS_COLLECTION_COLLECTION_INFO=collection_info
MILVUS_DIMENSION=1536
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=COSINE
MILVUS_NLIST=128

# ============================================
# Redis Cache Settings
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DEFAULT_TTL=600 # 15 p

# ============================================
# LLM Settings (LiteLLM Router)
# ============================================
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LLM_MODEL=groq
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_STREAMING=false
LLM_TIMEOUT=60

# LiteLLM Router Database (for model management and cost tracking)
# Uses shared PostgreSQL instance from db/postgresql
LITELLM_DB_HOST=localhost
LITELLM_DB_PORT=5432
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=
LITELLM_DB_PASSWORD=
LITELLM_STORE_MODEL_IN_DB=true

# ============================================
# Embedding Settings
# ============================================
# Provider: onnx-service (recommended), triton, or openai
EMBEDDING_PROVIDER=onnx-service
#EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768
# ONNX Service Configuration (if provider=onnx-service)
ONNX_SERVICE_URL=http://localhost:7000

# OpenAI Configuration (if provider=openai)
OPENAI_API_KEY=
OPENAI_API_BASE=


# Triton Configuration (if provider=triton)
TRITON_URL=http://localhost:8000
TRITON_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2



# ============================================
# Langfuse Settings (Observability)
# ============================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ENVIRONMENT=production


# ============================================
# Guardrails Settings (NeMo Guardrails)
# ============================================
CONFIG_PATH=./guardrails
ENABLE_INPUT_VALIDATION=true
ENABLE_OUTPUT_VALIDATION=true
ENABLE_PII_MASKING=true

# Llama Guard model via LiteLLM Router
GUARD_MODEL=groq-llama-guard
GUARD_BASE_URL=http://localhost:4000
GUARD_API_KEY=

# ============================================
# Groq API Key (for LiteLLM Router)
# ============================================
GROQ_API_KEY=

